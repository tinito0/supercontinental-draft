{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          {
            "key": "Content-Security-Policy-Report-Only",
            "value": "default-src 'self'; script-src 'self' https://apis.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; font-src 'self' data:; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://*.supabase.co https://api.giphy.com https://api.klipy.com; frame-src 'self' https://*.firebaseapp.com https://accounts.google.com https://apis.google.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
          },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" }
        ]
      },
      {
        "source": "index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/!(*.*)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=31536000"
          }
        ]
      }
    ],
    "redirects": [
      { "source": "/login", "destination": "/draft/login", "type": 301 },
      { "source": "/overview", "destination": "/draft/overview", "type": 301 },
      { "source": "/marketplace", "destination": "/draft/marketplace", "type": 301 },
      { "source": "/my-team", "destination": "/draft/my-team", "type": 301 },
      { "source": "/scouting", "destination": "/draft/scouting", "type": 301 },
      { "source": "/other-teams", "destination": "/draft/other-teams", "type": 301 },
      { "source": "/financials", "destination": "/draft/financials", "type": 301 },
      { "source": "/admin", "destination": "/draft/admin", "type": 301 },
      { "source": "/tournament", "destination": "/draft/tournament", "type": 301 },
      { "source": "/overlay", "destination": "/draft/overlay", "type": 301 },
      { "source": "/tactics", "destination": "/draft/tactics", "type": 301 },
      { "source": "/tactics/:rest*", "destination": "/draft/tactics/:rest", "type": 301 },
      { "source": "/pes", "destination": "/draft/pes", "type": 301 },
      { "source": "/pes/:rest*", "destination": "/draft/pes/:rest", "type": 301 },
      { "source": "/modal/:rest*", "destination": "/draft/modal/:rest", "type": 301 },
      { "source": "/team/:rest*", "destination": "/draft/team/:rest", "type": 301 }
    ],
    "rewrites": [
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
