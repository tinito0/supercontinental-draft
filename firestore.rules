rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isShortText(value, max) {
      return value is string && value.size() <= max;
    }

    function isAdmin() {
      return isAuth() && (
        request.auth.uid == "2Qn5j9a9ABW66iPyFL6ZfqwXBqG3" ||
        (request.auth.token.keys().hasAny(['admin']) && request.auth.token.admin == true)
      );
    }

    // ── ARTIFACTS ─────────────────────────────────────────────
    match /artifacts/{appId} {

      // ── MERCADO ───────────────────────────────────────────────
      // Fichajes y traspasos los ejecuta el servidor (Edge Function `market` de Supabase, con una
      // cuenta de servicio que no pasa por estas reglas): valida precios reales, presupuesto y estado
      // del mercado. Desde el navegador nadie escribe locks, presupuestos, el feed ni ofertas
      // aceptadas. El presupuesto base vive en teams/{uid}.budget (useAuth lo copia al perfil).
      function defaultBudget() { return 200000000; }        // DEFAULT_BUDGET (utils/constants.js)

      function changedKeys() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }
      function teamPath(uid) {
        return /databases/$(database)/documents/artifacts/$(appId)/public/data/teams/$(uid);
      }
      function profilePath(uid) {
        return /databases/$(database)/documents/artifacts/$(appId)/users/$(uid)/profile/data;
      }
      function lockPath(playerId) {
        return /databases/$(database)/documents/artifacts/$(appId)/public/data/player_locks/$(playerId);
      }

      // Player locks: los crea, mueve y libera el servidor (liberar cierra las ofertas abiertas por el
      // jugador; desde el navegador quedaban reteniendo el dinero de los compradores).
      match /public/data/player_locks/{playerId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      // Equipos públicos. El dueño edita su nombre, escudo, formación y plantilla visible; el
      // presupuesto y la whitelist sólo los cambia el admin (o el servidor en un traspaso).
      match /public/data/teams/{teamId} {
        allow read: if true;
        allow create: if isAuth() && (
          isAdmin() || (
            request.auth.uid == teamId
            && request.resource.data.get('inWhitelist', false) == false
            && (request.resource.data.budget == defaultBudget()
              || request.resource.data.budget == get(profilePath(teamId)).data.budget)
          )
        );
        allow update: if isAuth() && (
          isAdmin()
          || (request.auth.uid == teamId && !changedKeys().hasAny(['budget', 'inWhitelist', 'userId', 'marketUpdatedAt']))
        );
        allow delete: if isAdmin();
      }

      // Feed de transferencias: lo escribe el servidor, que también borra el fichaje al liberar.
      match /public/data/transfers/{transferId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      // Ofertas de traspaso. Lectura abierta a managers. Aceptar la ejecuta el servidor; el resto
      // de la negociación la escriben los participantes, por turnos.
      match /public/data/offers/{offerId} {
        allow read: if isAuth();
        allow create: if isAuth() && (
          isAdmin() || (
            request.resource.data.senderId == request.auth.uid
            && request.resource.data.targetTeamId != request.auth.uid
            && request.resource.data.status == 'pending'
            && isMoney(request.resource.data.offerAmount)
          )
        );
        allow update: if isAuth() && (
          isAdmin() || (
            request.auth.uid in [resource.data.senderId, resource.data.targetTeamId]
            && changedKeys().hasOnly(['status', 'offerAmount', 'counterAmount', 'history', 'rejectedAt', 'rejectedBy',
              'withdrawnAt', 'counterAt', 'counterBy', 'reofferedAt'])
            && isOfferTransition()
          )
        );
        allow delete: if isAdmin();

        // Montos: enteros positivos. Las ofertas pendientes retienen fondos del comprador; un monto
        // negativo o no numérico liberaría presupuesto (supabase/functions/_shared/budget.js).
        function isMoney(value) {
          return value is int && value > 0;
        }

        // Igual que buildOfferUpdate (services/transferService.js):
        // pending:   vendedor → rejected | countered; comprador → withdrawn
        // countered: comprador → rejected | withdrawn | pending (nueva oferta); vendedor → withdrawn
        function isOfferTransition() {
          let from = resource.data.status;
          let to = request.resource.data.status;
          let isSeller = request.auth.uid == resource.data.targetTeamId;
          let amountsKept = !changedKeys().hasAny(['offerAmount', 'counterAmount']);
          return (from == 'pending' && isSeller && to == 'rejected' && amountsKept)
            || (from == 'pending' && isSeller && to == 'countered' && !changedKeys().hasAny(['offerAmount'])
              && isMoney(request.resource.data.counterAmount))
            || (from == 'pending' && !isSeller && to == 'withdrawn' && amountsKept)
            || (from == 'countered' && !isSeller && to in ['rejected', 'withdrawn'] && amountsKept)
            || (from == 'countered' && !isSeller && to == 'pending' && !changedKeys().hasAny(['counterAmount'])
              && isMoney(request.resource.data.offerAmount))
            || (from == 'countered' && isSeller && to == 'withdrawn' && amountsKept);
        }

        // Chat de la negociación: solo los dos clubes de la oferta, mientras sigue abierta, con texto corto.
        // Antes cualquier manager podía escribir en cualquier oferta, sin límite de largo.
        match /messages/{messageId} {
          allow read: if isAuth();
          allow create: if isAuth() && (isAdmin() || (
            request.resource.data.senderId == request.auth.uid
            && request.auth.uid in [negotiation().senderId, negotiation().targetTeamId]
            && negotiation().status in ['pending', 'countered']
            && request.resource.data.keys().hasOnly(['senderId', 'senderTeamName', 'senderTeamLogo', 'text', 'createdAt', 'createdAtIso'])
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 500
            && isShortText(request.resource.data.get('senderTeamName', ''), 80)
            && isShortText(request.resource.data.get('senderTeamLogo', ''), 1000)
          ));
          allow update, delete: if isAdmin();

          function negotiation() {
            return get(/databases/$(database)/documents/artifacts/$(appId)/public/data/offers/$(offerId)).data;
          }
        }
      }

      // Manager chat
      // Solo managers con sesión (antes era legible sin iniciar sesión). Un mensaje puede ser solo un GIF: el texto
      // vacío se rechazaba aunque el chat permitía mandarlo.
      match /public/data/manager_chat/{messageId} {
        allow read: if isAuth();
        allow create: if isAuth()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 1000
          && isGifUrl(request.resource.data.get('gifUrl', ''))
          && (request.resource.data.text.size() > 0 || request.resource.data.get('gifUrl', '') != '')
          && isShortText(request.resource.data.get('senderTeamName', ''), 80);
        allow update, delete: if isAdmin();

        function isGifUrl(url) {
          return url == '' || (url is string && url.size() <= 600 && url.matches('https://[^ ]+'));
        }
      }

      // Formaciones compartidas: cualquier persona puede verlas, pero sólo su autor
      // (o un admin) puede crear, editar o eliminar su propio snapshot.
      match /public/data/shared_formations/{formationId} {
        allow read: if true;
        allow create: if isAuth()
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if isAdmin() || (
          resource.data.createdBy == request.auth.uid
          && request.resource.data.createdBy == resource.data.createdBy
        );
        allow delete: if isAdmin() || resource.data.createdBy == request.auth.uid;
      }

      // Buzón privado para administración. El cliente sólo puede enviar un mensaje
      // identificado con su propia cuenta; no puede leer ni modificar mensajes ajenos.
      match /public/data/suggestions/{suggestionId} {
        allow read: if isAdmin();
        allow create: if isAuth()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 10
          && request.resource.data.text.size() <= 4000;
        allow update, delete: if isAdmin();
      }

      // Datos de visualización pública.
      match /public/data/news/{newsId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /public/data/tournament/{tournamentId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /public/data/broadcast/{overlayId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      // La configuración de mercado cambia permisos funcionales y debe ser admin-only.
      match /public/data/config/{configId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      // Colección legacy usada exclusivamente por operaciones de mantenimiento.
      match /public/data/locks/{lockId} {
        allow read, write: if isAdmin();
      }

      // Presencia online de managers
      match /presence/{userId} {
        allow read: if true;
        allow create, update: if isAuth() && (request.auth.uid == userId || isAdmin());
        allow delete: if isAuth();
      }

      // ── USUARIOS ──────────────────────────────────────────────
      // Carrito privado de usuario: validación de requisitos de Jugador Franquicia
      match /users/{userId}/cart/{playerId} {
        allow read, delete: if isAuth() && (request.auth.uid == userId || isAdmin());
        // Copia privada de los jugadores propios (la autoridad es el lock). Un jugador figura como
        // franquicia sólo si su lock, escrito por el servidor, lo dice.
        allow create, update: if isAuth() && (request.auth.uid == userId || isAdmin()) && (
          request.resource.data.isFranchise != true || (
            get(lockPath(playerId)).data.lockedBy == userId &&
            get(lockPath(playerId)).data.isFranchise == true
          )
        );
      }

      // El presupuesto del perfil es una copia del público (teams/{uid}.budget): sólo puede tomar
      // el valor que el equipo tiene después de esta escritura. isAdmin, role y los datos de franquicia
      // no los escribe el usuario (la franquicia la marca el servidor al fichar).
      match /users/{userId}/profile/data {
        allow read: if isAuth() && (request.auth.uid == userId || isAdmin());
        allow create: if isAuth() && (
          isAdmin() || (
            request.auth.uid == userId
            && request.resource.data.get('budget', defaultBudget()) == defaultBudget()
            && !request.resource.data.keys().hasAny(['isAdmin', 'role', 'franchisePlayerId'])
            && request.resource.data.get('franchisePlayerUsed', false) == false
          )
        );
        allow update: if isAuth() && (
          isAdmin() || (
            request.auth.uid == userId &&
            !changedKeys().hasAny(['isAdmin', 'role', 'franchisePlayerUsed', 'franchisePlayerId']) &&
            (!changedKeys().hasAny(['budget']) || request.resource.data.budget == getAfter(teamPath(userId)).data.budget)
          )
        );
        allow delete: if isAdmin();
      }

      // Resto de colecciones del usuario (notifications, tactics, notes, ratings)
      match /users/{userId}/{collectionId}/{docId} {
        allow read, write: if isAuth() && (request.auth.uid == userId || isAdmin()) && !(collectionId in ['cart', 'profile']);
      }

      // ── EDITOR PES 2021 ───────────────────────────────────────
      // Roles: super_admin (todo), draft_admin (solo lectura), kit_manager (kits, colores de
      // equipo y UniColors). Sin rol = sin acceso. Las listas de campos deben coincidir con
      // pes/kits/kitConfig.js, pes/kits/kitFonts.js y pes/permissions.js (tests/pes/rulesSync.test.js).
      function pesRoleIs(roles) {
        return isAuth()
          && exists(/databases/$(database)/documents/artifacts/$(appId)/pes_roles/$(request.auth.uid))
          && get(/databases/$(database)/documents/artifacts/$(appId)/pes_roles/$(request.auth.uid)).data.role in roles;
      }
      function isPesSuper() {
        return isAdmin() || pesRoleIs(['super_admin']);
      }
      function isKitManager() {
        return pesRoleIs(['kit_manager']);
      }
      function hasPesRole() {
        return isPesSuper() || pesRoleIs(['draft_admin', 'kit_manager']);
      }
      function pesKitKeys() {
        return ['ShortSleevesModel', 'ShirtModel', 'Collar', 'TightKit', 'ShirtPattern', 'WinterCollar', 'LongSleevesType',
          'Name', 'NameShape', 'NameY', 'NameSize', 'NameStretch', 'BackNumberY', 'BackNumberSize', 'BackNumberSpacing', 'BackNumberType',
          'ChestNumberX', 'ChestNumberY', 'ChestNumberSize',
          'ShortsModel', 'ShortsNumberSide', 'ShortsNumberX', 'ShortsNumberY', 'ShortsNumberSize',
          'KitFile', 'BackNumbersFile', 'ChestNumbersFile', 'LegNumbersFile', 'NameFontFile',
          'ShirtColor1', 'ShirtColor2', 'UndershirtColor', 'ShortsColor', 'SocksColor', 'UniColor_Color1', 'UniColor_Color2',
          'RightShortX', 'RightShortY', 'RightLongX', 'RightLongY', 'LeftShortX', 'LeftShortY', 'LeftLongX', 'LeftLongY',
          'CaptainArmband'];
      }
      function pesTextureSlots() {
        return ['kit', 'nrm', 'srm', 'name', 'back', 'chest', 'leg'];
      }
      function pesTeamColorFields() {
        return ['c1r', 'c1g', 'c1b', 'c2r', 'c2g', 'c2b'];
      }
      function pesOpTypes() {
        return ['bin.team.set', 'bin.player.set', 'bin.coach.set', 'bin.team.tactics', 'bin.assignment.set', 'bin.assignment.add', 'bin.assignment.remove',
          'edit.team.set', 'edit.player.set', 'edit.coach.set', 'edit.roster.number', 'edit.roster.player', 'edit.team.squad', 'edit.roster.remove',
          'kit.set', 'kit.texture.set', 'kit.add'];
      }
      function pesInLeague(wsId, op) {
        let league = get(/databases/$(database)/documents/artifacts/$(appId)/pes_workspaces/$(wsId)).data.get('leagueTeamIds', []);
        return league.size() == 0 || op.target.teamId in league;
      }
      function pesKitOpAllowed(wsId, op) {
        return isKitManager() && pesInLeague(wsId, op) && (
          (op.type == 'kit.set' && op.key in pesKitKeys()) ||
          op.type == 'kit.add' ||
          (op.type == 'kit.texture.set' && op.slot in pesTextureSlots() && op.ext in ['.ftex', '.dds']) ||
          (op.type == 'edit.team.set' && op.field in pesTeamColorFields())
        );
      }

      match /pes_roles/{uid} {
        allow read: if isAuth() && (request.auth.uid == uid || isPesSuper());
        allow write: if isPesSuper()
          && (request.method == 'delete' || request.resource.data.role in ['super_admin', 'draft_admin', 'kit_manager']);
      }

      match /pes_workspaces/{wsId} {
        allow read: if hasPesRole();
        allow write: if isPesSuper();

        // Historial de modificaciones: inmutable salvo el descarte.
        match /ops/{opId} {
          allow read: if hasPesRole();
          allow create: if isAuth()
            && request.resource.data.actorUid == request.auth.uid
            && request.resource.data.state == 'saved'
            && request.resource.data.type in pesOpTypes()
            && (isPesSuper() || pesKitOpAllowed(wsId, request.resource.data));
          allow update: if isAuth()
            && (isPesSuper() || resource.data.actorUid == request.auth.uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'discardedBy', 'discardedAt'])
            && request.resource.data.state == 'discarded'
            && request.resource.data.discardedBy == request.auth.uid;
          allow delete: if isPesSuper();
        }

        // Las texturas (kits y fuentes) viven en Supabase Storage; ver supabase/storage-policies.sql.

        // Una actualización del manifiesto solo puede agregar entradas: nunca cambiar ni quitar las existentes.
        function kitTexturesOnlyAdded(next, prev) {
          return next.diff(prev).changedKeys().size() == 0 && next.diff(prev).removedKeys().size() == 0;
        }

        // Qué texturas originales del kit-server de un equipo están compartidas en Supabase
        // (services/pesWorkspaceService.js addKitTextures). Solo se agregan entradas.
        match /kit_textures/{teamId} {
          allow read: if hasPesRole();
          allow create, update: if isAuth()
            && (resource == null || kitTexturesOnlyAdded(request.resource.data.files, resource.data.files))
            && request.resource.data.updatedBy == request.auth.uid
            && request.resource.data.keys().hasOnly(['teamId', 'files', 'updatedBy', 'updatedAt'])
            && request.resource.data.files is map
            && request.resource.data.teamId == int(teamId)
            && (isPesSuper() || (isKitManager() && pesInLeague(wsId, { 'target': { 'teamId': int(teamId) } })));
          allow delete: if isPesSuper();
        }

        // Historial de exportaciones: inmutable; sólo se borra junto con el espacio (Super Admin).
        match /exports/{exportId} {
          allow read: if hasPesRole();
          allow create: if isPesSuper() && request.resource.data.exportedBy == request.auth.uid;
          allow update: if false;
          allow delete: if isPesSuper();
        }

        // Última validación (cualquier rol la puede refrescar).
        match /meta/{docId} {
          allow read: if hasPesRole();
          allow write: if hasPesRole();
        }
      }
    }

    // ── CATCH-ALL: deny everything not explicitly matched ──
    match /{document=**} {
      allow read, write: if isAdmin();
    }

  }
}
